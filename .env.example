# Server Configuration
PORT=3000
NODE_ENV=development

# Gemini API Key (Required for actual LLM calls)
# Add your key here. Do not commit your real key to git.
GEMINI_API_KEY=your_gemini_api_key_here

# Optional: override the Gemini model name (defaults to gemini-2.5-flash).
# Update this if Google rotates/retires the default model.
GEMINI_MODEL=gemini-2.5-flash
